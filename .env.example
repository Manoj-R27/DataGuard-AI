# Shared key required by POST /ingest and protected evaluation endpoints.
DATAGUARD_API_KEY=local-dev-key
# SQLAlchemy database URL; Docker Compose overrides this to the Postgres service.
DATABASE_URL=sqlite:///./dataguard.db
# Base URL used by the scheduler when submitting simulated batches.
DATAGUARD_API_URL=http://localhost:8000
# Primary application log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
# Backward-compatible scheduler log-level setting.
DATAGUARD_LOG_LEVEL=INFO
# Postgres username used by Docker Compose.
POSTGRES_USER=dataguard
# Postgres password used by Docker Compose; replace for deployment.
POSTGRES_PASSWORD=replace-with-a-database-password
# Postgres database name used by Docker Compose.
POSTGRES_DB=dataguard